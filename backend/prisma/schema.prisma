datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Shop {
  id            String         @id @default(uuid()) @db.Uuid
  name          String
  email         String
  phone         String?
  address       String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?
  
  users         User[]
  roles         Role[]
  customers     Customer[]
  pawnTickets   PawnTicket[]
  payments      Payment[]
  ledgerEntries LedgerEntry[]
  auditLogs     AuditLog[]
  activityLogs  ActivityLog[]
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique // e.g., "read:dashboard", "manage:pawns"
  name        String
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  roles       RolePermission[]
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  shopId      String           @db.Uuid
  name        String
  description String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  
  shop        Shop             @relation(fields: [shopId], references: [id], onDelete: Cascade)
  users       User[]
  permissions RolePermission[]

  @@unique([shopId, name])
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  createdAt    DateTime   @default(now())

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model User {
  id             String        @id @default(uuid()) @db.Uuid
  shopId         String        @db.Uuid
  roleId         String?       @db.Uuid
  firstName      String
  lastName       String
  email          String
  username       String
  password       String
  phone          String?
  isActive       Boolean       @default(true)
  language       String        @default("en")
  lastLoginAt    DateTime?
  loginAttempts  Int           @default(0)
  lockedUntil    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  shop           Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  role           Role?         @relation(fields: [roleId], references: [id], onDelete: SetNull)
  createdCustomers Customer[]  @relation("UserCreatedCustomers")
  auditLogs      AuditLog[]
  activityLogs   ActivityLog[]

  @@unique([shopId, email])
  @@unique([shopId, username])
}

model Customer {
  id                        String       @id @default(uuid()) @db.Uuid
  shopId                    String       @db.Uuid
  createdByUserId           String?      @db.Uuid
  full_name                 String
  phone_number              String
  gender                    String?      // "Male" | "Female" | "Other"
  customer_photo_url        String?
  aadhaar_number_encrypted  String?
  aadhaar_number_last4      String?
  pan_number_encrypted      String?
  pan_number_last4          String?
  address_line1             String?
  address_city              String?
  address_pincode           String?
  dateOfBirth               DateTime?
  occupation                String?
  nominee_name              String?
  nominee_phone             String?
  nominee_relation          String?
  notes                     String?
  customerCode              String?
  photo                     String?
  kycStatus                 String       @default("pending") // "pending" | "verified" | "rejected"
  kycVerifiedAt             DateTime?
  createdAt                 DateTime     @default(now())
  updatedAt                 DateTime     @updatedAt
  deletedAt                 DateTime?

  shop                      Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  createdBy                 User?        @relation("UserCreatedCustomers", fields: [createdByUserId], references: [id], onDelete: SetNull)
  pawnTickets               PawnTicket[]
  payments                  Payment[]

  @@index([shopId])
  @@index([phone_number])
  @@index([createdAt])
  @@index([deletedAt])
}

model PawnTicket {
  id                   String         @id @default(uuid()) @db.Uuid
  shopId               String         @db.Uuid
  customerId           String         @db.Uuid
  ticket_number        String
  loan_amount          Decimal        @db.Decimal(12, 2)
  original_loan_amount Decimal        @db.Decimal(12, 2)
  interest_rate        Decimal        @db.Decimal(5, 2)
  adv_amount           Decimal        @db.Decimal(12, 2)
  interestType         String         @default("monthly") // "monthly" | "daily" | "simple" | "compound"
  graceDays            Int            @default(0)
  loanDuration         Int            @default(12) // in months
  pawned_date          DateTime       @default(now())
  renewalDate          DateTime?
  maturityDate         DateTime?
  auctionDate          DateTime?
  status               String         @default("active") // "active" | "settled" | "defaulted"
  settled_date         DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  deletedAt            DateTime?

  shop                 Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customer             Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items                PawnItem[]
  payments             Payment[]
  ledgerEntries        LedgerEntry[]

  @@unique([shopId, ticket_number])
  @@index([shopId])
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@index([deletedAt])
}

model PawnItem {
  id             String     @id @default(uuid()) @db.Uuid
  ticketId       String     @db.Uuid
  name           String
  type           String?    // e.g., "Gold", "Silver"
  weight_grams   Decimal    @db.Decimal(10, 3)
  purity         String?
  description    String?
  item_photo_url String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime?

  ticket         PawnTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}

model Payment {
  id           String        @id @default(uuid()) @db.Uuid
  shopId       String        @db.Uuid
  customerId   String        @db.Uuid
  ticketId     String        @db.Uuid
  amount_paid  Decimal       @db.Decimal(12, 2)
  payment_for  String        // "principal" | "interest" | "penalty" | "fine" | "auction" | "processing_fee" | "service_fee" | "waiver" | "discount"
  payment_date DateTime      @default(now())
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?

  shop         Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  ticket       PawnTicket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ledgerEntries LedgerEntry[]

  @@index([shopId])
  @@index([ticketId])
  @@index([createdAt])
  @@index([deletedAt])
}

model LedgerEntry {
  id          String      @id @default(uuid()) @db.Uuid
  shopId      String      @db.Uuid
  ticketId    String?     @db.Uuid
  paymentId   String?     @db.Uuid
  type        String      // "debit" | "credit"
  category    String      // "principal_disbursed" | "principal_repaid" | "interest_received" | "penalty_collected" | "fee_collected"
  amount      Decimal     @db.Decimal(12, 2)
  entryDate   DateTime    @default(now())
  description String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  shop        Shop        @relation(fields: [shopId], references: [id], onDelete: Cascade)
  ticket      PawnTicket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  payment     Payment?    @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([shopId])
  @@index([entryDate])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  shopId     String   @db.Uuid
  userId     String?  @db.Uuid
  entityName String   // e.g., "Customer", "PawnTicket"
  entityId   String
  action     String   // "create" | "update" | "delete"
  oldValue   Json?
  newValue   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  shop       Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([shopId])
  @@index([createdAt])
}

model ActivityLog {
  id        String   @id @default(uuid()) @db.Uuid
  shopId    String   @db.Uuid
  userId    String?  @db.Uuid
  action    String   // e.g., "login", "export:report"
  details   Json
  createdAt DateTime @default(now())

  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([shopId])
  @@index([createdAt])
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

model Shop {
  id            String         @id @default(uuid()) @db.Uuid
  name          String
  email         String
  phone         String?
  address       String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?
  
  users         User[]
  roles         Role[]
  customers     Customer[]
  pawnTickets   PawnTicket[]
  payments      Payment[]
  ledgerEntries LedgerEntry[]
  auditLogs     AuditLog[]
  activityLogs  ActivityLog[]
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique // e.g., "read:dashboard", "manage:pawns"
  name        String
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  roles       RolePermission[]
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  shopId      String           @db.Uuid
  name        String
  description String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  
  shop        Shop             @relation(fields: [shopId], references: [id], onDelete: Cascade)
  users       User[]
  permissions RolePermission[]

  @@unique([shopId, name])
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  createdAt    DateTime   @default(now())

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model User {
  id             String        @id @default(uuid()) @db.Uuid
  shopId         String        @db.Uuid
  roleId         String?       @db.Uuid
  firstName      String
  lastName       String
  email          String
  username       String
  password       String
  phone          String?
  isActive       Boolean       @default(true)
  isEmailVerified Boolean      @default(false)  
  language       String        @default("en")
  lastLoginAt    DateTime?
  loginAttempts  Int           @default(0)
  lockedUntil    DateTime? 
  emailVerifiedAt      DateTime?
  resetPasswordToken   String?
  resetPasswordExpires DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  shop           Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  role           Role?         @relation(fields: [roleId], references: [id], onDelete: SetNull)
  createdCustomers Customer[]  @relation("UserCreatedCustomers")
  auditLogs      AuditLog[]
  activityLogs   ActivityLog[]

  @@unique([shopId, email])
  @@unique([shopId, username])
}

model Customer {
  id                     String       @id @default(uuid()) @db.Uuid
  shopId                 String       @db.Uuid
  createdByUserId        String?      @db.Uuid
  fullName               String       @map("full_name")
  phoneNumber            String       @map("phone_number")
  gender                 String? // "Male" | "Female" | "Other"
  customerPhotoUrl       String?      @map("customer_photo_url")
  aadhaarNumberEncrypted String?      @map("aadhaar_number_encrypted")
  aadhaarNumberLast4     String?      @map("aadhaar_number_last4")
  panNumberEncrypted     String?      @map("pan_number_encrypted")
  panNumberLast4         String?      @map("pan_number_last4")
  addressLine1           String?      @map("address_line1")
  addressCity            String?      @map("address_city")
  addressPincode         String?      @map("address_pincode")
  dateOfBirth            DateTime?
  occupation             String?
  nomineeName            String?      @map("nominee_name")
  nomineePhone           String?      @map("nominee_phone")
  nomineeRelation        String?      @map("nominee_relation")
  notes                  String?
  customerCode           String?
  photo                  String?
  kycStatus              String       @default("pending") // "pending" | "verified" | "rejected"
  kycVerifiedAt          DateTime?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  deletedAt              DateTime?

  shop             Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  createdBy        User?        @relation("UserCreatedCustomers", fields: [createdByUserId], references: [id], onDelete: SetNull)
  pawnTickets      PawnTicket[]
  payments         Payment[]

  @@index([shopId])
  @@index([phoneNumber])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([shopId, createdAt])
}

model PawnTicket {
  id                 String    @id @default(uuid()) @db.Uuid
  shopId             String    @db.Uuid
  customerId         String    @db.Uuid
  ticketNumber       String    @map("ticket_number")
  loanAmount         Decimal   @map("loan_amount") @db.Decimal(12, 2)
  originalLoanAmount Decimal   @map("original_loan_amount") @db.Decimal(12, 2)
  interestRate       Decimal   @map("interest_rate") @db.Decimal(5, 2)
  advAmount          Decimal   @map("adv_amount") @db.Decimal(12, 2)
  interestType       String    @default("monthly")
  graceDays          Int       @default(0)
  loanDuration       Int       @default(12)
  pawnedDate         DateTime  @default(now()) @map("pawned_date")
  renewalDate        DateTime?
  maturityDate       DateTime?
  auctionDate        DateTime?
  status             String    @default("active")
  settledDate        DateTime? @map("settled_date")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  shop          Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customer      Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items         PawnItem[]
  payments      Payment[]
  ledgerEntries LedgerEntry[]

  @@unique([shopId, ticketNumber])
  @@index([shopId])
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([shopId, status])
  @@index([shopId, customerId])
  @@index([shopId, createdAt])
}

model PawnItem {
  id           String    @id @default(uuid()) @db.Uuid
  ticketId     String    @db.Uuid
  name         String
  type         String?
  weightGrams  Decimal   @map("weight_grams") @db.Decimal(10, 3)
  purity       String?
  description  String?
  itemPhotoUrl String?   @map("item_photo_url")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  ticket PawnTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}

model Payment {
  id             String    @id @default(uuid()) @db.Uuid
  shopId         String    @db.Uuid
  customerId     String    @db.Uuid
  ticketId       String    @db.Uuid
  amountPaid     Decimal   @map("amount_paid") @db.Decimal(12, 2)
  paymentFor     String    @map("payment_for")
  paymentDate    DateTime  @default(now()) @map("payment_date")
  idempotencyKey String?   @unique @db.VarChar(128)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  shop          Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customer      Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  ticket        PawnTicket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ledgerEntries LedgerEntry[]

  @@index([shopId])
  @@index([ticketId])
  @@index([idempotencyKey])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([shopId, customerId])
  @@index([shopId, createdAt])
}

model LedgerEntry {
  id          String      @id @default(uuid()) @db.Uuid
  shopId      String      @db.Uuid
  ticketId    String?     @db.Uuid
  paymentId   String?     @db.Uuid
  type        String      // "debit" | "credit"
  category    String      // "principal_disbursed" | "principal_repaid" | "interest_received" | "penalty_collected" | "fee_collected"
  amount      Decimal     @db.Decimal(12, 2)
  entryDate   DateTime    @default(now())
  description String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  shop        Shop        @relation(fields: [shopId], references: [id], onDelete: Cascade)
  ticket      PawnTicket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  payment     Payment?    @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([shopId])
  @@index([entryDate])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  shopId     String   @db.Uuid
  userId     String?  @db.Uuid
  entityName String   // e.g., "Customer", "PawnTicket"
  entityId   String
  action     String   // "create" | "update" | "delete"
  oldValue   Json?
  newValue   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  shop       Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([shopId])
  @@index([createdAt])
}

model ActivityLog {
  id        String   @id @default(uuid()) @db.Uuid
  shopId    String   @db.Uuid
  userId    String?  @db.Uuid
  action    String   // e.g., "login", "export:report"
  details   Json
  createdAt DateTime @default(now())

  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([shopId])
  @@index([createdAt])
}
